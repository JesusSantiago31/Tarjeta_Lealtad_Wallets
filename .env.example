# ==========================================
# 1. CONFIGURACIÓN GENERAL Y RATE LIMITING
# ==========================================
PROJECT_NAME="Cafeteria Loyalty Cards API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
DEFAULT_RATE_LIMIT="100/minute"

# ==========================================
# 2. SEGURIDAD Y TOKEN JWT (BACKEND)
# ==========================================
JWT_SECRET_KEY="cafeteria_loyalty_secret"
SECRET_KEY="cafeteria_loyalty_secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==========================================
# 3. CONEXIÓN A SUPABASE
# ==========================================
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
DATABASE_URL="postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres"

# ==========================================
# 4. STORAGE DE IMÁGENES IMGBB
# ==========================================
IMGBB_API_KEY="016f99f44aa63831f98810db57015c46"

# ==========================================
# 5. CREDENCIALES Y DISEÑO DE GOOGLE WALLET API
# ==========================================
GOOGLE_ISSUER_ID="3388000000023191405"
GOOGLE_CLASS_ID="cafeteria_generic_v6"
GOOGLE_CLIENT_EMAIL="your-service-account@developer.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

CAFETERIA_NAME="Cafetería"
CAFETERIA_SUBHEADER="Datos de Cliente"
CAFETERIA_BG_COLOR="#a4c0a2"

CAFETERIA_LOGO_URL="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTBl6LKbfzoGTny4NdhmY6Sb918FWDa0NZ_8XNWPh5BjQ&s"
CAFETERIA_HERO_IMAGE_URL="https://img.freepik.com/vector-gratis/hermoso-banner-floral-plantilla-hojas_21799-2813.jpg?w=740&q=80"

# ==========================================
# 6. FRONTEND VITE (REACT SPA)
# ==========================================
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
